{
  "manifest_version": 3,
  "name": "iHAVECPU คัดลอกสินค้า + รูป",
  "version": "2.5.18",
  "description": "คัดลอกชื่อสินค้า ราคา ลิงก์ และรูปสินค้าจาก iHAVECPU ด้วยปุ่มหรือคีย์ลัด",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "storage",
    "notifications",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://ihavecpu.com/*",
    "https://www.ihavecpu.com/*",
    "https://app.zaapi.com/*",
    "https://admeta.me/*",
    "https://ihcupload-bkk.s3.ap-southeast-7.amazonaws.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://ntfy.sh/*"
  ],
  "commands": {
    "copy-product": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "เตรียมข้อความและรูปสินค้าใน Zaapi โดยไม่ส่ง"
    },
    "fill-zaapi-message": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "ใส่ข้อความสินค้าในช่องแชต Zaapi โดยไม่ส่ง"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ihavecpu.com/*",
        "https://www.ihavecpu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.zaapi.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://admeta.me/admin/*"
      ],
      "js": [
        "admeta-spec-builder.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ตั้งค่าคัดลอกสินค้า iHAVECPU"
  }
}
